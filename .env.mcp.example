# Server-only configuration. Never use a VITE_ prefix for these values.
MCP_RESOURCE_URL=https://unified-acs.vercel.app/api/mcp
MCP_OAUTH_ISSUER=https://YOUR-TENANT.auth0.com/
MCP_OAUTH_JWKS_URL=https://YOUR-TENANT.auth0.com/.well-known/jwks.json
MCP_ALLOWED_SUBJECTS=auth0|YOUR-OWNER-USER-ID
MCP_DATABASE_URL=postgresql://acs_mcp_login.YOUR-PROJECT-REF:PRIVATE-ENCODED-PASSWORD@YOUR-POOLER-HOST:6543/postgres
# Optional: Supabase certificate PEM if the endpoint CA isn't in the default trust store.
# Actual multiline PEM or escaped \n are accepted. TLS verification remains enabled.
MCP_DATABASE_CA=
